APP_NAME=ai-nepal-platform-backend
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_nepal_platform
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
ADMIN_API_KEY=

# Rate Limiting Configuration (Public API Abuse Prevention)
# Enable/disable rate limiting for public tool execution endpoints
RATE_LIMIT_ENABLED=true
# Max requests per rate limit window (requests per RATE_LIMIT_WINDOW_SECONDS)
RATE_LIMIT_REQUESTS=20
# Time window for rate limiting in seconds
RATE_LIMIT_WINDOW_SECONDS=60
